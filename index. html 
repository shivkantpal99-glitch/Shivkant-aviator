<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Aviator Game</title>
<style>
body {
  margin:0;
  background:#101827;
  color:white;
  font-family:Arial;
  text-align:center;
}
h1 {color:#ff4545}
.game {
  margin:20px auto;
  max-width:450px;
  padding:20px;
  background:#1c2a40;
  border-radius:15px;
}
.screen {
  height:230px;
  background:linear-gradient(#152b48,#091321);
  border-radius:12px;
  position:relative;
  overflow:hidden;
}
#plane {
  position:absolute;
  font-size:45px;
  left:15px;
  bottom:15px;
}
#multiplier {
  font-size:42px;
  font-weight:bold;
  margin-top:55px;
  color:#35e68b;
}
button {
  padding:14px 25px;
  border:0;
  border-radius:10px;
  color:white;
  font-size:17px;
  margin:8px;
  background:#16a36a;
}
#cash {background:#e04a42}
</style>
</head>
<body>

<h1>✈ AVIATOR</h1>

<div class="game">
  <h3>Balance: <span id="balance">1000</span> Coins</h3>

  <div class="screen">
    <div id="multiplier">1.00x</div>
    <div id="plane">✈️</div>
  </div>

  <p>Bet Amount</p>
  <input id="bet" type="number" value="100" min="1">

  <br>
  <button onclick="startGame()">PLAY</button>
  <button id="cash" onclick="cashOut()" disabled>CASH OUT</button>

  <h3 id="status">Ready to Fly!</h3>
</div>

<script>
let balance = 1000;
let bet = 100;
let multiplier = 1;
let crashAt = 2;
let running = false;
let timer;

const plane = document.getElementById("plane");
const screen = document.querySelector(".screen");

function startGame() {
  if(running) return;

  bet = Number(document.getElementById("bet").value);

  if(bet <= 0 || bet > balance) {
    document.getElementById("status").innerText =
      "Invalid Bet!";
    return;
  }

  balance -= bet;
  multiplier = 1;
  crashAt = 1.2 + Math.random() * 5;
  running = true;

  document.getElementById("balance").innerText = balance;
  document.getElementById("cash").disabled = false;
  document.getElementById("status").innerText = "Flying...";

  clearInterval(timer);

  timer = setInterval(() => {
    multiplier += 0.01 + multiplier * 0.008;

    document.getElementById("multiplier").innerText =
      multiplier.toFixed(2) + "x";

    let x = Math.min(15 + multiplier * 35, 340);
    let y = Math.min(15 + multiplier * 22, 160);

    plane.style.left = x + "px";
    plane.style.bottom = y + "px";

    if(multiplier >= crashAt) {
      clearInterval(timer);
      running = false;
      document.getElementById("cash").disabled = true;
      document.getElementById("status").innerText =
        "💥 CRASHED! Try Again";
    }
  }, 100);
}

function cashOut() {
  if(!running) return;

  clearInterval(timer);
  running = false;

  let win = Math.floor(bet * multiplier);
  balance += win;

  document.getElementById("balance").innerText = balance;
  document.getElementById("cash").disabled = true;
  document.getElementById("status").innerText =
    "🎉 You Won " + win + " Coins!";
}
</script>

</body>
</html>